# //solo es un prototipo de codigo .env 
ENV=production
APP_ENV=production
INSTALL_ENABLED=false
APP_NAME="Sietelsa Online"
APP_URL=https://sietelsaonline.com
APP_TIMEZONE=America/El_Salvador
APP_LOG_PATH=/var/www/html/logs/app.log

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sietelsa
DB_USER=sietelsa
DB_PASS=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Sietelsa"
SMTP_CONTACT_DEST=

# GeoIP para analytics de visitas
SIETELSA_VISITAS_GEOIP_HTTP_ENABLED=true
SIETELSA_VISITAS_GEOIP_URL_TEMPLATE=https://ipapi.co/{ip}/json/
SIETELSA_VISITAS_GEOIP_CACHE_TTL_OK=2592000
SIETELSA_VISITAS_GEOIP_CACHE_TTL_ERROR=1800
SIETELSA_VISITAS_GEOIP_BACKFILL_ENABLED=true
SIETELSA_VISITAS_GEOIP_BACKFILL_LIMIT=25
SIETELSA_VISITAS_GEOIP_BACKFILL_TTL=120
